public class Main
{
	public static void main(String[] args) {
# Pedir dos números enteros
num1 = int(input("Ingrese el primer número: "))
num2 = int(input("Ingrese el segundo número: "))

# Verificar si el primero es divisible entre el segundo
if num1 % num2 == 0:
    print("El primer número es divisible entre el segundo")
else:
    print("El primer número no es divisible entre el segundo")
	}
}
